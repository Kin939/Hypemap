# Базовый URL API (пусто = same-origin, как в продакшене через Pages Function)
VITE_API_BASE=

# База Dynmap (пусто = same-origin /up, /tiles). Для локальной разработки
# без mock-сервера можно указать http://127.0.0.1:8123
VITE_DYNMAP_BASE=

# Заголовок сайта, если API недоступен
VITE_SITE_TITLE=Hypemap
